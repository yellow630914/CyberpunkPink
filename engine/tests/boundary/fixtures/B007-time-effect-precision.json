{
  "id": "B007-time-effect-precision",
  "note": "預設設定。算回報交 time 1e300 小時：照給，time.day 變成 4.1666666666666667e298（不是安全整數，hour 與 minute 是雜訊；之後再加分鐘天數不會動）。存檔照樣讀得回來。期望：換算之後不是安全整數的值在算回報就判格式錯誤。",
  "seed": 7,
  "setup": {
    "scenario": "emptyRoom",
    "ai": { "ai": 1, "retry": { "reward": 0 } },
    "fake": { "byTask": { "reward": [{ "json": { "items": [{ "kind": "time", "hours": 1e300, "from": { "source": "degree" } }] } }] } }
  },
  "inputs": [
    { "type": "act", "input": { "kind": "free", "text": "我等一下" } }
  ],
  "expect": { "paths": { "time": { "day": 1, "hour": 8, "minute": 30 } } }
}
