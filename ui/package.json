{
  "name": "cyberpunkpink-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CyberpunkPink 的互動介面 v1（Vue 3 + Pinia + Vite）。引擎的介面參考實作，資料是假的。",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/build-icons.mjs",
    "build": "node scripts/build-icons.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.1.1"
  }
}
